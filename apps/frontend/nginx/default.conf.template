# Plantilla: el entrypoint de nginx reemplaza solo las variables de entorno
# definidas (GRAPHQL_UPSTREAM); las de nginx ($uri, $host...) quedan intactas.
server {
  listen 8080;
  root /usr/share/nginx/html;

  location = /healthz {
    access_log off;
    default_type text/plain;
    return 200 "ok\n";
  }

  # En kind el Ingress ya manda /graphql directo al gateway (y Argo reparte su
  # canary). Esto cubre docker compose y el acceso directo al Service.
  location /graphql {
    proxy_pass ${GRAPHQL_UPSTREAM};
    proxy_http_version 1.1;
    proxy_set_header Upgrade $http_upgrade;
    proxy_set_header Connection $connection_upgrade;
    proxy_set_header Host $host;
    proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
    proxy_read_timeout 3600s;
    proxy_send_timeout 3600s;
  }

  # Archivos con hash en el nombre: se pueden cachear para siempre.
  location /assets/ {
    add_header Cache-Control "public, max-age=31536000, immutable";
    add_header X-Content-Type-Options nosniff;
    try_files $uri =404;
  }

  # SPA: cualquier otra ruta devuelve index.html (sin caché, para tomar la versión nueva).
  location / {
    add_header Cache-Control "no-cache";
    add_header X-Content-Type-Options nosniff;
    add_header X-Frame-Options DENY;
    add_header Referrer-Policy same-origin;
    try_files $uri /index.html;
  }
}
