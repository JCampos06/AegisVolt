{
  "name": "graphql-gateway",
  "version": "0.1.0",
  "private": true,
  "description": "BFF GraphQL (esquema unificado) + orquestador SAGA Reservar y Activar Carga",
  "type": "module",
  "main": "./dist/server.js",
  "files": [
    "dist"
  ],
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "lint": "tsc -p tsconfig.json --noEmit",
    "dev": "tsx watch src/server.ts",
    "start": "node dist/server.js",
    "test": "vitest run",
    "test:int": "vitest run --config vitest.int.config.ts --passWithNoTests"
  },
  "dependencies": {
    "@aegisvolt/shared": "workspace:*",
    "@apollo/server": "^5.5.2",
    "@as-integrations/fastify": "^3.1.0",
    "@aws-sdk/client-dynamodb": "^3.1169.0",
    "@aws-sdk/lib-dynamodb": "^3.1169.0",
    "@fastify/cors": "^11.4.3",
    "@graphql-tools/schema": "^11.0.9",
    "fastify": "^5.12.8",
    "graphql": "^16.15.0",
    "graphql-subscriptions": "^3.0.0",
    "graphql-ws": "^6.4.2",
    "ws": "^8.23.0"
  },
  "devDependencies": {
    "@types/node": "^24.19.2",
    "@types/ws": "^8.18.2",
    "tsx": "^4.23.15",
    "typescript": "^6.0.3",
    "vitest": "^5.1.0"
  }
}
