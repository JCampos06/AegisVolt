{
  "name": "energy-dispatch-service",
  "version": "0.1.0",
  "private": true,
  "description": "Activación física simulada y telemetría (paso 3 de la SAGA)",
  "type": "module",
  "main": "./dist/server.js",
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "lint": "tsc -p tsconfig.json --noEmit",
    "dev": "tsx watch src/server.ts",
    "start": "node dist/server.js",
    "test": "vitest run",
    "test:int": "vitest run --config vitest.int.config.ts"
  },
  "dependencies": {
    "@aegisvolt/shared": "workspace:*",
    "@aws-sdk/client-dynamodb": "^3.1169.0",
    "@aws-sdk/lib-dynamodb": "^3.1169.0",
    "fastify": "^5.12.8"
  },
  "devDependencies": {
    "@types/node": "^24.19.2",
    "tsx": "^4.23.15",
    "typescript": "^6.0.3",
    "vitest": "^5.1.0"
  }
}
