{
  "name": "@aegisvolt/shared",
  "version": "0.1.0",
  "private": true,
  "description": "Código transversal: config, logger (CloudWatch), correlation-id, feature flags, http-client con retry, idempotencia",
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    },
    "./testing": {
      "types": "./dist/testing.d.ts",
      "default": "./dist/testing.js"
    }
  },
  "files": [
    "dist"
  ],
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "lint": "tsc -p tsconfig.json --noEmit",
    "test": "vitest run"
  },
  "dependencies": {
    "@aws-sdk/client-cloudwatch-logs": "^3.1169.0",
    "@aws-sdk/client-dynamodb": "^3.1169.0",
    "@aws-sdk/lib-dynamodb": "^3.1169.0",
    "fastify": "^5.12.8",
    "pino": "^10.4.0"
  },
  "devDependencies": {
    "@types/node": "^24.19.2",
    "typescript": "^6.0.3",
    "vitest": "^5.1.0"
  }
}
