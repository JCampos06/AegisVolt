# Copiar a .env (ignorado por git). Credenciales ficticias: Floci acepta cualquier valor no vacío.
AWS_ENDPOINT_URL=http://localhost:4566
AWS_DEFAULT_REGION=us-east-1
AWS_ACCESS_KEY_ID=test
AWS_SECRET_ACCESS_KEY=test
APP_ENV=dev

# docker compose: etiqueta de las imágenes (en CI será el SHA del commit) y token admin
# del gateway (solo se exige para setFeatureFlag en prod). Pon un valor propio en .env.
IMAGE_TAG=local
ADMIN_TOKEN=
